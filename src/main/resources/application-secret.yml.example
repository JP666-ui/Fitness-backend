# ============================================================
# 私密配置模板
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 application-secret.yml（同目录下）
#   2. 填入你自己的 API Key
#   3. application-secret.yml 已被 .gitignore 忽略，不会上传
#
# 也可以改用环境变量，无需本文件：
#   AI_GLM_API_KEY / BAIDU_OCR_ACCESS_KEY / BAIDU_OCR_SECRET_KEY
# ============================================================

# 智谱 GLM-4-Flash（完全免费）
# 申请地址：https://open.bigmodel.cn
ai:
  glm:
    api-key: 你的智谱API_KEY

# 百度 OCR（用于饮食记录的拍照识别，可选）
# 申请地址：https://console.bce.baidu.com/ai/
baidu:
  ocr:
    access-key: 你的百度API_KEY
    secret-key: 你的百度SECRET_KEY

# 如需自定义数据库密码，取消注释并修改
# spring:
#   datasource:
#     password: 你的MySQL密码
